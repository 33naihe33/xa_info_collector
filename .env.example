# 雄安信息商机挖掘系统 - 环境变量模板
# 使用方法：复制为 .env 并填入真实值
# cp .env.example .env

# ---- 必填：智谱 LLM API Key ----
# 获取：https://open.bigmodel.cn/
ZHIPUAI_API_KEY=your_zhipuai_api_key_here

# ---- 可选：Web Push VAPID 密钥（推送功能依赖）----
# 生成：python -c "from py_vapid import Vapid; v=Vapid(); print(v.generate_keys())"
# 不配置时推送功能不可用（前端订阅会提示未配置）
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# ---- 可选：数据目录（默认 <项目根>/data）----
# 部署到非项目目录/wheel 安装时建议显式指定可写目录
# XA_DATA_DIR=/var/lib/xa-collector

# ---- 可选：CORS 允许的前端源（逗号分隔）----
# 默认仅 loopback：http://127.0.0.1:8000,http://localhost:8000
# 对外部署时必须显式配置，例如：
# CORS_ORIGINS=https://your-frontend.example.com

# ---- 可选：.env 文件路径（默认当前目录 .env）----
# XA_ENV_PATH=/etc/xa-collector/.env
